# =============================================================================
# ClusterGate - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before starting.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://clustergate:changeme@localhost:5432/clustergate?schema=public"
POSTGRES_USER=clustergate
POSTGRES_PASSWORD=changeme
POSTGRES_DB=clustergate

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# REQUIRED: Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_64
JWT_EXPIRES_IN=7d

# Encryption key for route secrets at rest (API/upstream auth values, webhook
# secrets) — AES-256-GCM. Generate with: openssl rand -base64 48
# If unset, a key is derived from JWT_SECRET. IMPORTANT: keep this stable —
# changing it (or JWT_SECRET, when ENCRYPTION_KEY is unset) makes existing
# encrypted secrets unreadable. The SAME value is required to restore a backup
# of route secrets onto another instance.
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48

# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,https://clustergate.example.com

# Express "trust proxy": number of trusted proxy hops, or "false" to trust none.
# Set to "false" when ClusterGate is exposed DIRECTLY to the internet (no
# ingress/LB in front) so clients can't spoof X-Forwarded-For to bypass IP
# allowlists and rate limits. Default 1 (single ingress/LB, e.g. k8s).
TRUST_PROXY=1

# Apply pending Prisma migrations automatically on startup (recommended).
AUTO_MIGRATE=true

# Proxy settings
PROXY_TIMEOUT=30000
# Max request body size forwarded through the proxy (raw passthrough)
PROXY_BODY_LIMIT=50mb
# Stream request bodies straight to the target (unbuffered) for large uploads.
# Bodies are still buffered when a route needs them (webhook signature /
# transforms). Off by default (uses the buffered raw parser).
PROXY_STREAM_REQUESTS=false

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Metrics
METRICS_ENABLED=true
METRICS_SECRET=CHANGE_ME_METRICS_SECRET

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Cleanup
LOG_RETENTION_DAYS=90

# Scheduled backups
# Set to true to enable automatic scheduled backups
BACKUP_CRON_ENABLED=false
# Cron schedule expression (default: daily at 3am)
BACKUP_CRON_SCHEDULE=0 3 * * *
# Maximum number of backup files to retain (oldest are deleted)
BACKUP_RETENTION_COUNT=10

# -----------------------------------------------------------------------------
# Kubernetes self-update (only used when running in-cluster)
# The in-app updater patches these deployments to the new image tag.
# -----------------------------------------------------------------------------
K8S_NAMESPACE=clustergate
K8S_BACKEND_DEPLOYMENT=clustergate-backend
K8S_FRONTEND_DEPLOYMENT=clustergate-frontend

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=ClusterGate
NEXT_PUBLIC_APP_VERSION=1.0.0
